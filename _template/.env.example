# .env.example - copy this file ONCE to ".env" in this folder (the repo root) and paste your key.
#
#   macOS / Linux:        cp .env.example .env
#   Windows PowerShell:   Copy-Item .env.example .env
#
# Every episode folder finds this one .env file by itself (llm.py looks in parent folders).
# NEVER share your .env file or upload it to GitHub (it is already in .gitignore).
# Settings checked on 2026-10-23.

# ---------------------------------------------------------------------------
# 1. Google Gemini (DEFAULT) - FREE key, no credit card
#    1. Open https://aistudio.google.com/apikey
#    2. Sign in with Google, accept the terms, click "Create API key"
#    3. Paste it below (no quotes, no spaces)
#    Free-tier limits are per Google Cloud project; see https://aistudio.google.com/rate-limit
#    On the free tier Google may use your prompts to improve its products: never paste private data.
#    (GOOGLE_API_KEY also works. If both are set, GOOGLE_API_KEY wins.)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=paste-your-key-here

# ---------------------------------------------------------------------------
# 2. Which AI provider?  gemini | openai | anthropic | ollama
#    This ONE line switches every episode project to another provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Optional: a different model of the same provider (leave empty for the default).
#   gemini    default: gemini-3.5-flash-lite   (smarter but slower: gemini-3.8-flash)
#   openai    default: gpt-6-luna
#   anthropic default: claude-haiku-5-5
#   ollama    default: qwen3.5:4b
LLM_MODEL=

# ---------------------------------------------------------------------------
# 3. OpenAI (paid) - https://platform.openai.com/api-keys
#    Then set LLM_PROVIDER=openai
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 4. Anthropic Claude (paid) - https://platform.claude.com/settings/keys
#    Then set LLM_PROVIDER=anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 5. Ollama (free, runs on your own computer, no key)
#    1. Install from https://ollama.com/download
#    2. In a terminal:  ollama pull qwen3.5:4b
#    3. Set LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# 6. Embeddings (for clustering, RAG and vector databases)
#    local  = free model on your computer (default, downloads ~90 MB once)
#    gemini = Google's gemini-embedding-2 (free tier, uses GEMINI_API_KEY)
#    If you change this, delete and rebuild your vector database folder.
# ---------------------------------------------------------------------------
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=

# ---------------------------------------------------------------------------
# 7. Other services used in some episodes
# ---------------------------------------------------------------------------
# Apify (web scraping episode): https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Identifies you to websites when LangChain's WebBaseLoader downloads a page.
USER_AGENT=ai-engineering-course/1.0

# Turn off usage telemetry of CrewAI and Chroma.
CREWAI_DISABLE_TELEMETRY=true
ANONYMIZED_TELEMETRY=False
# Stop CrewAI from collecting execution traces on your first crew run (and from asking about it).
CREWAI_TRACING_ENABLED=false
